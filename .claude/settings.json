{
  "permissions": {
    "allow": [
      "mcp__Notion__notion-search",
      "mcp__Notion__notion-fetch",
      "mcp__Notion__notion-query-data-sources",
      "mcp__Notion__notion-query-multiple-data-sources",
      "mcp__Notion__notion-get-users",
      "mcp__Notion__notion-get-comments",
      "mcp__Notion__notion-list-page-backlinks",
      "mcp__Notion__notion-get-async-task",
      "mcp__Notion__notion-create-pages",
      "mcp__Notion__notion-update-page",
      "mcp__Notion__notion-update-data-source",
      "mcp__Notion__notion-create-comment"
    ],
    "ask": [
      "mcp__Notion__notion-delete-pages",
      "mcp__Notion__notion-delete-databases",
      "mcp__Notion__notion-delete-comment"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Buffer__create_post|mcp__Buffer__edit_post|SendUserFile|Artifact|mcp__claude-artifacts__publish_files|mcp__claude-artifacts__publish_version",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/skills/marketing-copy-gate/scripts/post_gate_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
